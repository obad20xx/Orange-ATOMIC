### VS Code ###
.vscode/
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# IDE Specific
.idea/
*.iml
.classpath
.project
.settings/

# ============================================================
# Terraform
# ============================================================
# Local .terraform directory (contains provider binaries)
**/.terraform/*
.terraform/

# Terraform state files — state is stored remotely in Azure Blob Storage
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable values file — contains environment-specific secrets.
# Supply values via Azure Pipelines variable groups or -var flags.
terraform/terraform.tfvars

# Terraform plan output (binary)
terraform/tfplan

# Terraform crash log
crash.log
crash.*.log

# Terraform lock file is committed (ensures provider version consistency)
# .terraform.lock.hcl  <- intentionally NOT ignored

# ============================================================
# Ignore local GitLab CI/CD configuration files (legacy)
# ============================================================
.gitlab-ci-local